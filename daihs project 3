        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def simulate_pk(dose_mg, half_life_hrs, vd_l, duration_hrs=48):\n",
        "    # Calculate elimination rate constant (ke)\n",
        "    ke = np.log(2) / half_life_hrs\n",
        "\n",
        "    # Generate time points (e.g., every 15 minutes)\n",
        "    time_steps = np.linspace(0, duration_hrs, duration_hrs * 4)\n",
        "\n",
        "    # Calculate concentration over time: C(t) = (Dose / Vd) * e^(-ke * t)\n",
        "    concentrations = (dose_mg / vd_l) * np.exp(-ke * time_steps)\n",
        "\n",
        "    return time_steps, concentrations\n",
        "\n",
        "def plot_curve(time, conc, drug_name):\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    plt.plot(time, conc, label=f'{drug_name} Concentration', color='blue', linewidth=2)\n",
        "    plt.axhline(y=max(conc)*0.1, color='r', linestyle='--', label='Minimum Effective Conc. (Est.)')\n",
        "    plt.title(f'One-Compartment Pharmacokinetic Simulation: {drug_name}')\n",
        "    plt.xlabel('Time (Hours)')\n",
        "    plt.ylabel('Plasma Concentration (mg/L)')\n",
        "    plt.legend()\n",
        "    plt.grid(True)\n",
        "\n",
        "    # Save the plot automatically to add to your GitHub README\n",
        "    plt.savefig('pk_simulation_plot.png')\n",
        "    print(\"Simulation complete. Plot saved as 'pk_simulation_plot.png'\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    # Example: Simulating a 500mg IV dose of an antibiotic\n",
        "    # Half-life = 6 hours, Volume of Distribution = 25 Litres\n",
        "    time, conc = simulate_pk(dose_mg=500, half_life_hrs=6, vd_l=25)\n",
        "    plot_curve(time, conc, \"Antibiotic-X\")"
      ]
    }
